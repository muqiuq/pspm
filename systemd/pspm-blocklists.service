[Unit]
Description=PSPM external blocklists
After=network-online.target docker.service
ConditionPathExists=/srv/pspm/app/current/bin/blocklists.php

[Service]
Type=oneshot
User=pspm
Group=pspm
ExecStart=/usr/bin/php /srv/pspm/app/current/bin/blocklists.php
Nice=10
TimeoutStartSec=900
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
