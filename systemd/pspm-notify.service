[Unit]
Description=PSPM health checks and e-mail notifications
After=network-online.target docker.service
ConditionPathExists=/srv/pspm/app/current/bin/notify.php

[Service]
Type=oneshot
User=pspm
Group=pspm
ExecStart=/usr/bin/php /srv/pspm/app/current/bin/notify.php
Nice=10
TimeoutStartSec=900
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
