# PSPM writes nothing into this checkout at runtime: state, logs, secrets and releases
# live in /etc/pspm, /var/lib/pspm, /var/log/pspm and /srv/pspm. The patterns below are
# a safety net for files a manual run, a test or an editor may leave behind.
# Do not add a generic "vendor/" pattern: app/assets/vendor/ is vendored on purpose.

# Generated by install.sh into app releases (never part of the source)
/app/COMMIT

# Runtime files, should anything ever be pointed at the checkout
*.log
*.pid
*.sock
*.lock
*.tsv
/state/
/status/
/releases/
/backups/

# Secrets and keys: never commit
db.env
app.key
*.env
!*.env.example
*.key
*.p12
*.pfx
privkey*.pem
*-password.txt

# Test and development scratch
.tmp/
.tmp-*
*.tmp
/tests/out/
.phpunit.result.cache

# Editors and operating systems
*.swp
*.swo
*~
.DS_Store
.idea/
.vscode/
.claude/settings.local.json
